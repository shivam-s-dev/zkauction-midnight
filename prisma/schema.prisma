generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AuctionContract {
  id               String          @id @default(uuid())
  contractAddress  String          @unique
  itemDescription  String
  deployerAddress  String?
  deployTxHash     String?
  createdAt        DateTime        @default(now())
  events           AuctionEvent[]
}

model AuctionEvent {
  id              String          @id @default(uuid())
  contractAddress String
  eventType       String          // AUCTION_CREATED | BID_PLACED | SETTLED | EXPIRED | WITHDRAWN
  txHash          String?         // on-chain tx hash — optional (no hash for off-chain create)
  amountMicro     BigInt?         // bid amount in micro-tNIGHT — null for non-bid events
  createdAt       DateTime        @default(now())

  auction         AuctionContract @relation(fields: [contractAddress], references: [contractAddress], onDelete: Cascade)

  @@index([contractAddress])
}
